*.log
.DS_Store
.env
.env.backup
.env.production
.phpactor.json
.phpunit.result.cache
/.fleet
/.idea
/.nova
/.phpunit.cache
/.vscode
/.zed
/auth.json
/node_modules
/public/build
/public/hot
/public/storage
/storage/*.key
/storage/pail
/vendor
Homestead.json
Homestead.yaml
Thumbs.db

# Vibe service (deployed separately from R2)
vibe-service/
public/vibe/

# Build artifacts — regenerated, not source
# nativephp/ ya se auto-ignora (su propio .gitignore es '*'); se regenera con
# `php artisan native:install android`. native-builds/ son APKs compiladas.
/nativephp/
/native-builds/

# Storage volátil — contenido, no la estructura (los .gitkeep quedan)
# (los subdirs de framework/ ya traen su propio .gitignore que se auto-excluye)
/storage/framework/*.php
/storage/app/private/*
/storage/app/public/*
/storage/app/spike/
/storage/app/spike-test/
/storage/framework/cache/*
/storage/framework/sessions/*
/storage/framework/testing/*
/storage/framework/views/*
/storage/logs/*

# Base de datos local — runtime artifact
/database/*.sqlite

# AI tools & agent config — local only (incluye .devin, que es su propio repo)
/.ai
/.boost
/.claude
/.cursor
/.devin
/.mcp.json
/.qodo
/.windsurf
/boost.json
/skills-lock.json

# Documentación — la doc completa vive en un repo privado (.devin/);
# en este repo solo son públicos el README y docs/ (versión en inglés)
*.md
!README.md
!docs/**

# Files
*.keystore
*.keystore.b64
*.zip

# Re-incluir placeholders de directorios
!**/.gitkeep
